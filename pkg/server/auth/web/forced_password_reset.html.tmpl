<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <title>Set a new password — Akashic</title>
  <link rel="stylesheet" href="/static/styles.css">
</head>
<body>
  <main class="card">
    <h1>Set a new password</h1>
    <p class="subtitle">
      An administrator issued you a temporary password. Pick a new
      one to finish signing in — the temporary password will stop
      working immediately.
    </p>

    {{if .PolicyHint}}
    <p class="policy-hint">{{.PolicyHint}}</p>
    {{end}}

    {{if .Error}}
    <p class="error" role="alert">{{.Error}}</p>
    {{end}}

    <form method="POST" action="/forced-password-reset/submit" autocomplete="off">
      <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
      <input type="hidden" name="return_to" value="{{.ReturnTo}}">

      <label for="password">New password</label>
      <input type="password" id="password" name="password" required autofocus
             autocomplete="new-password" minlength="{{.MinLength}}" />

      <label for="password_confirm">Confirm new password</label>
      <input type="password" id="password_confirm" name="password_confirm" required
             autocomplete="new-password" minlength="{{.MinLength}}" />

      <button type="submit">Save and continue</button>
    </form>
  </main>
</body>
</html>
