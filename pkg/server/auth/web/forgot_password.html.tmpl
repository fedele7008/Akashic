<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <title>Forgot password — Akashic</title>
  <link rel="stylesheet" href="/static/styles.css">
</head>
<body>
  <main class="card">
    <h1>Forgot password</h1>
    <p class="subtitle">Enter the email on your account; we'll send a 6-digit code.</p>

    {{if .Error}}
    <p class="error" role="alert">{{.Error}}</p>
    {{end}}

    <form method="POST" action="/forgot-password/submit" autocomplete="off">
      <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
      <input type="hidden" name="return_to" value="{{.ReturnTo}}">

      <label for="email">Email</label>
      <input type="email" id="email" name="email" required autofocus value="{{.Email}}" />

      <button type="submit">Send reset code</button>
    </form>

    <p class="cancel cancel-spaced">
      {{if .ReturnTo}}
      <a href="/login?return_to={{.ReturnTo}}">← Back to sign in</a>
      {{else}}
      <a href="/login">← Back to sign in</a>
      {{end}}
    </p>
  </main>
</body>
</html>
