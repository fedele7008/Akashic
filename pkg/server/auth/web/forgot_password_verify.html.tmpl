<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <title>Enter verification code — Akashic</title>
  <link rel="stylesheet" href="/static/styles.css">
</head>
<body>
  <main class="card">
    <h1>Enter verification code</h1>
    <p class="subtitle">
      We've sent a 6-digit code to <strong>{{.Email}}</strong>.
    </p>

    {{if .Notice}}
    <p class="success" role="status">{{.Notice}}</p>
    {{end}}

    {{if .Error}}
    <p class="error" role="alert">{{.Error}}</p>
    {{end}}

    <form method="POST" action="/forgot-password/verify/submit" autocomplete="off">
      <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
      <input type="hidden" name="email" value="{{.Email}}">
      <input type="hidden" name="return_to" value="{{.ReturnTo}}">

      <label for="code">6-digit code</label>
      <input type="text" id="code" name="code" required autofocus
             inputmode="numeric" pattern="[0-9]{6}" maxlength="6"
             autocomplete="one-time-code"
             class="otp-input" />

      <button type="submit">Verify code</button>
    </form>

    <!-- Resend: a separate form posting back to /submit. Server
         treats this exactly like the original submit (supersede-
         on-resend in the store; per-email rate limit applies).
         Lands back on this page with the "code sent" banner. -->
    <form method="POST" action="/forgot-password/submit" autocomplete="off" class="resend-form">
      <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
      <input type="hidden" name="email" value="{{.Email}}">
      <input type="hidden" name="return_to" value="{{.ReturnTo}}">
      <button type="submit" class="link-button">Didn't get the code? Resend</button>
    </form>

    <p class="cancel cancel-spaced">
      {{if .ReturnTo}}
      <a href="/forgot-password?return_to={{.ReturnTo}}">← Wrong email? Start over</a>
      {{else}}
      <a href="/forgot-password">← Wrong email? Start over</a>
      {{end}}
    </p>
  </main>
</body>
</html>
