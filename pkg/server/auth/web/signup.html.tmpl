<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <title>Create an account — Akashic</title>
  <link rel="stylesheet" href="/static/styles.css">
</head>
<body>
  <main class="card">
    <h1>Create an account</h1>
    <p class="subtitle">Akashic Identity Provider</p>

    {{if .Error}}
    <div class="error" role="alert">{{.Error}}</div>
    {{end}}

    {{if .PolicyHint}}
    <p class="policy-hint">{{.PolicyHint}}</p>
    {{end}}

    <form method="POST" action="/signup/submit" autocomplete="off">
      <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
      <input type="hidden" name="return_to" value="{{.ReturnTo}}">

      <label>
        <span>Email</span>
        <input type="email" name="email" required autofocus
               spellcheck="false" autocapitalize="off"
               autocomplete="email"
               value="{{.Email}}">
      </label>

      <details style="margin-top: -8px;">
        <summary style="font-size: 0.875rem; color: var(--text-muted); cursor: pointer;">
          Customise account ID (optional)
        </summary>
        <div style="display: flex; flex-direction: column; gap: 16px; margin-top: 12px;">
          <label>
            <span>ID <em>(optional)</em></span>
            <input type="text" name="username"
                   spellcheck="false" autocapitalize="off"
                   minlength="2" maxlength="32"
                   pattern="[a-zA-Z0-9._-]+"
                   value="{{.Username}}">
            <small style="color: var(--text-muted); font-size: 0.8125rem; margin-top: 4px;">
              2–32 chars: letters, digits, dots, hyphens, underscores.
              Defaults to your email's prefix.
            </small>
          </label>

          <label>
            <span>Tag <em>(optional)</em></span>
            <input type="text" name="tag"
                   spellcheck="false" autocapitalize="off"
                   minlength="4" maxlength="4"
                   pattern="[a-zA-Z0-9]{4}"
                   value="{{.Tag}}">
            <small style="color: var(--text-muted); font-size: 0.8125rem; margin-top: 4px;">
              Exactly 4 chars (0–9, a–z). Auto-generated if blank.
              Your final ID will be <code>id#tag</code>.
            </small>
          </label>
        </div>
      </details>

      <label>
        <span>Display name <em>(optional)</em></span>
        <input type="text" name="display_name"
               autocomplete="name"
               value="{{.DisplayName}}">
      </label>

      <label>
        <span>Password</span>
        <input type="password" name="password" required
               autocomplete="new-password">
      </label>

      <label>
        <span>Confirm password</span>
        <input type="password" name="password_confirm" required
               autocomplete="new-password">
      </label>

      <button type="submit">Create account</button>
    </form>

    <p class="signup-prompt">
      Already have an account?
      <a href="/login{{if .ReturnTo}}?return_to={{.ReturnTo}}{{end}}">Sign in</a>
    </p>
  </main>
</body>
</html>
