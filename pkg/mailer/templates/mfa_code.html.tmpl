<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>{{.TenantName}} sign-in code</title>
</head>
<body style="margin:0;padding:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:#f5f5f7;color:#1d1d1f;">
  <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background:#f5f5f7;padding:32px 16px;">
    <tr>
      <td align="center">
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="max-width:560px;background:#ffffff;border-radius:12px;padding:32px;">
          <tr>
            <td style="padding-bottom:16px;">
              <h1 style="margin:0;font-size:1.25rem;font-weight:600;">Your sign-in code</h1>
              <p style="margin:8px 0 0 0;color:#6e6e73;font-size:0.9rem;">{{.TenantName}}</p>
            </td>
          </tr>
          <tr>
            <td style="padding:8px 0;">
              <p style="margin:0;font-size:1rem;line-height:1.5;">Hi {{.DisplayName}},</p>
              <p style="margin:12px 0;font-size:1rem;line-height:1.5;">
                Use this code to finish signing in to
                <strong>{{.TenantName}}</strong>:
              </p>
            </td>
          </tr>
          <tr>
            <td align="center" style="padding:16px 0;">
              <div style="display:inline-block;padding:14px 28px;background:#f5f5f7;border-radius:8px;font-family:'SF Mono',Menlo,monospace;font-size:1.5rem;font-weight:600;letter-spacing:0.25rem;color:#1d1d1f;">
                {{.Code}}
              </div>
            </td>
          </tr>
          <tr>
            <td style="padding:8px 0;">
              <p style="margin:0;font-size:0.875rem;color:#6e6e73;line-height:1.5;">
                This code expires in
                <strong>{{.ExpiresInMinutes}} minutes</strong>.
                If you didn't just try to sign in, you can ignore
                this email — your account remains protected.
              </p>
              <p style="margin:12px 0 0 0;font-size:0.875rem;color:#6e6e73;line-height:1.5;">
                <strong>Don't share this code with anyone.</strong>
                {{.TenantName}} will never ask you for it.
              </p>
            </td>
          </tr>
          <tr>
            <td style="padding-top:24px;border-top:1px solid #e5e5e7;">
              <p style="margin:12px 0 0 0;font-size:0.75rem;color:#86868b;text-align:center;">
                Sent by {{.TenantName}}
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
