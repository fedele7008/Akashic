<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>New sign-in — {{.TenantName}}</title>
</head>
<body style="margin:0;padding:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:#f5f5f7;color:#1d1d1f;">
  <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background:#f5f5f7;padding:32px 16px;">
    <tr>
      <td align="center">
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="max-width:560px;background:#ffffff;border-radius:12px;padding:32px;">
          <tr>
            <td style="padding-bottom:16px;">
              <h1 style="margin:0;font-size:1.25rem;font-weight:600;">New sign-in</h1>
              <p style="margin:8px 0 0 0;color:#6e6e73;font-size:0.9rem;">{{.TenantName}}</p>
            </td>
          </tr>
          <tr>
            <td style="padding:8px 0;">
              <p style="margin:0;font-size:1rem;line-height:1.5;">Hi {{.DisplayName}},</p>
              <p style="margin:12px 0;font-size:1rem;line-height:1.5;">
                Your <strong>{{.TenantName}}</strong> account was just
                signed in to.
              </p>
            </td>
          </tr>
          <tr>
            <td style="padding:8px 0;">
              <table cellpadding="6" cellspacing="0" border="0" style="font-size:0.9rem;background:#f5f5f7;border-radius:8px;width:100%;">
                <tr>
                  <td style="color:#6e6e73;width:33%;">Time</td>
                  <td>{{.Timestamp}}</td>
                </tr>
                <tr>
                  <td style="color:#6e6e73;">IP address</td>
                  <td><code>{{.IPAddress}}</code></td>
                </tr>
                <tr>
                  <td style="color:#6e6e73;">Device</td>
                  <td>{{.Device}}</td>
                </tr>
                {{if .ClientName}}
                <tr>
                  <td style="color:#6e6e73;">Application</td>
                  <td>{{.ClientName}}</td>
                </tr>
                {{end}}
              </table>
            </td>
          </tr>
          <tr>
            <td style="padding:8px 0;">
              <p style="margin:12px 0;font-size:0.9rem;line-height:1.5;">
                If this was you, no further action is needed.
              </p>
              <p style="margin:12px 0;font-size:0.9rem;line-height:1.5;">
                <strong>If you don't recognize this sign-in</strong>,
                secure your account immediately: change your
                password, review and revoke trusted devices in your
                Two-factor authentication settings, and contact your
                administrator.
              </p>
            </td>
          </tr>
          <tr>
            <td style="padding-top:24px;border-top:1px solid #e5e5e7;">
              <p style="margin:12px 0 0 0;font-size:0.75rem;color:#86868b;text-align:center;">
                You can turn off these notifications from your
                profile's "Notification preferences" section.<br>
                Sent by {{.TenantName}}
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
