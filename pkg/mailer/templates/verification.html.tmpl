<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Verify your email for {{.TenantName}}</title>
</head>
<body style="margin:0;padding:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:#f5f5f7;color:#1d1d1f;">
  <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background:#f5f5f7;padding:32px 16px;">
    <tr>
      <td align="center">
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="max-width:560px;background:#ffffff;border-radius:12px;padding:32px;">
          <tr>
            <td style="padding-bottom:16px;">
              <h1 style="margin:0;font-size:1.25rem;font-weight:600;">Verify your email</h1>
              <p style="margin:8px 0 0 0;color:#6e6e73;font-size:0.9rem;">{{.TenantName}}</p>
            </td>
          </tr>
          <tr>
            <td style="padding:8px 0;">
              <p style="margin:0;font-size:1rem;line-height:1.5;">
                Hi {{.DisplayName}},
              </p>
              <p style="margin:12px 0;font-size:1rem;line-height:1.5;">
                Please confirm this is your email address for
                <strong>{{.TenantName}}</strong> by clicking the
                button below:
              </p>
            </td>
          </tr>
          <tr>
            <td align="center" style="padding:20px 0;">
              <a href="{{.VerifyURL}}"
                 style="display:inline-block;background:#4f8cff;color:#ffffff;text-decoration:none;padding:12px 24px;border-radius:8px;font-weight:500;">
                Verify email
              </a>
            </td>
          </tr>
          <tr>
            <td style="padding:8px 0;">
              <p style="margin:0;font-size:0.875rem;color:#6e6e73;line-height:1.5;">
                Or copy this link into your browser:
              </p>
              <p style="margin:6px 0 12px 0;font-size:0.8125rem;color:#1d1d1f;word-break:break-all;">
                <a href="{{.VerifyURL}}" style="color:#4f8cff;">{{.VerifyURL}}</a>
              </p>
              <p style="margin:12px 0;font-size:0.875rem;color:#6e6e73;line-height:1.5;">
                This link expires in <strong>{{.ExpiresInHours}} hours</strong>.
                If it expires, you can request a new one from your
                profile page after signing in.
              </p>
              <p style="margin:12px 0 0 0;font-size:0.875rem;color:#6e6e73;line-height:1.5;">
                If you didn't create this account, you can safely
                ignore this email.
              </p>
            </td>
          </tr>
          <tr>
            <td style="padding-top:24px;border-top:1px solid #e5e5e7;">
              <p style="margin:12px 0 0 0;font-size:0.75rem;color:#86868b;text-align:center;">
                Sent by {{.TenantName}}
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
