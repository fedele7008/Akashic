# ============================================================
# Required — must be set. Insecure / unbootable otherwise.
# ============================================================

# Crypto master key (32+ chars). Encrypts vault tokens at rest +
# DB-stored secrets. Loss = permanent vault lockout.
AKASHIC_SECRET=password123

# Public URLs the browser reaches. Must match real DNS.
AKASHIC_OAUTH_ISSUER=https://auth.akashic.example.com
AKASHIC_OAUTH_ADMIN_REDIRECT_URI=https://admin.akashic.example.com/oauth/callback
AKASHIC_PORTAL_API_BASE_URL=https://api.akashic.example.com

# Comma-separated tenant origins permitted to embed widgets.
# Required for any widget integration.
AKASHIC_PORTAL_TENANT_ORIGINS=

# Next.js sample's OAuth redirect URI (must match what you pass to
# `akashic-cli clients create --redirect-uri ...`).
AKASHIC_OAUTH_SAMPLE_NEXTJS_REDIRECT_URI=https://akashic.example.com/api/auth/callback

# ============================================================
# Dev credentials. Change for any non-local deployment.
# TLS toggles below default ON; flip OFF only for local debug.
# ============================================================
AKASHIC_DATABASE_POSTGRES_USERNAME=admin
AKASHIC_DATABASE_POSTGRES_PASSWORD=postgres123
AKASHIC_DATABASE_POSTGRES_DB=akashic

AKASHIC_DATABASE_REDIS_PASSWORD=redis123

AKASHIC_LDAP_ADMIN_PASSWORD=ldapadmin123
AKASHIC_LDAP_CONFIG_PASSWORD=ldapconfig123

AKASHIC_GF_SECURITY_ADMIN_USER=admin
AKASHIC_GF_SECURITY_ADMIN_PASSWORD=grafana123

AKASHIC_VAULT_PASSWORD=vault123

# Shared basic-auth for the localhost-bound admin tools
# (Adminer, RedisInsight, phpLDAPadmin).
AKASHIC_ADMINER_AUTH_USER=admin
AKASHIC_ADMINER_AUTH_PASSWORD=adminer123
AKASHIC_REDISINSIGHT_AUTH_USER=admin
AKASHIC_REDISINSIGHT_AUTH_PASSWORD=redisinsight123
AKASHIC_PHPLDAPADMIN_AUTH_USER=admin
AKASHIC_PHPLDAPADMIN_AUTH_PASSWORD=phpldapadmin123

# ============================================================
# Host port overrides — change only if you hit a conflict on
# your host. Defaults are applied in docker-compose.yml.
# ============================================================
AKASHIC_NGINX_PORT=8280
AKASHIC_AUTH_HOST_PORT=8080
AKASHIC_API_HOST_PORT=8082
AKASHIC_CTRL_HOST_PORT=8081
AKASHIC_VAULT_HOST_PORT=8200
AKASHIC_VAULT_CLUSTER_PORT=8201
AKASHIC_DATABASE_POSTGRES_HOST_PORT=5432
AKASHIC_DATABASE_REDIS_HOST_PORT=6379
AKASHIC_LOKI_PROXY_HOST_PORT=3100
AKASHIC_GF_HOST_PORT=3000
AKASHIC_LDAP_HOST_PORT=389
AKASHIC_LDAP_LDAPS_HOST_PORT=636
AKASHIC_PHPLDAPADMIN_HOST_PORT=25002

# ============================================================
# Optional toggles (uncomment to override compose defaults).
# ============================================================
# AKASHIC_OAUTH_ADMIN_BFF_ENABLED=true     # false → CLI-only mode (no admin web)
# AKASHIC_PKI_CERT_WATCHER_ENABLED=true    # false → manual cert reload
# AKASHIC_POSTGRES_TLS=on                  # on | off
# AKASHIC_REDIS_TLS=on
# AKASHIC_LDAP_TLS=on
# AKASHIC_LOKI_PROXY_TLS=on
# AKASHIC_TZ=UTC
