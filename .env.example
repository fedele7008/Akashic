# Nginx
AKASHIC_NGINX_PORT=8280
AKASHIC_ADMINER_AUTH_USER=admin
AKASHIC_ADMINER_AUTH_PASSWORD=adminer123
AKASHIC_REDISINSIGHT_AUTH_USER=admin
AKASHIC_REDISINSIGHT_AUTH_PASSWORD=redisinsight123
AKASHIC_PHPLDAPADMIN_AUTH_USER=admin
AKASHIC_PHPLDAPADMIN_AUTH_PASSWORD=phpldapadmin123

# Postgres
AKASHIC_POSTGRES_TLS=off  # on|off — forces TLS for TCP connections when on
AKASHIC_DATABASE_POSTGRES_USERNAME=admin
AKASHIC_DATABASE_POSTGRES_PASSWORD=postgres123
AKASHIC_DATABASE_POSTGRES_DB=akashic
AKASHIC_DATABASE_POSTGRES_HOST_PORT=5432

# Redis
AKASHIC_REDIS_TLS=on  # on|off -- forces TLS when on (plain port disabled)
AKASHIC_DATABASE_REDIS_PASSWORD=redis123
AKASHIC_DATABASE_REDIS_HOST_PORT=6379

# Loki Proxy (TLS-terminating nginx in front of Loki)
# The loki-proxy sits in front of the Loki backend. It listens on port 3100
# and is bound to 127.0.0.1 on the host, so host processes (e.g. the Akashic
# Go server running outside Docker) can reach it via localhost:3100.
#
# AKASHIC_LOKI_API_URL is auto-derived from AKASHIC_LOKI_PROXY_TLS,
# AKASHIC_LOKI_PROXY_HOST, and AKASHIC_LOKI_PROXY_HOST_PORT by the Akashic
# config loader -- toggle TLS in one place and the URL scheme follows.
# Set AKASHIC_LOKI_API_URL explicitly only to override the default derivation.
AKASHIC_LOKI_PROXY_TLS=on  # on|off -- loki-proxy terminates TLS when on
AKASHIC_LOKI_PROXY_HOST=localhost  # Akashic server reaches the proxy via this host
AKASHIC_LOKI_PROXY_HOST_PORT=3100

# Grafana
AKASHIC_GF_SECURITY_ADMIN_USER=admin
AKASHIC_GF_SECURITY_ADMIN_PASSWORD=grafana123
AKASHIC_GF_HOST_PORT=3000

# LDAP
AKASHIC_LDAP_TLS=on  # on|off -- forces LDAPS when on (LDAP_TLS_ENFORCE enabled)
AKASHIC_LDAP_ORGANISATION=Akashic
AKASHIC_LDAP_DOMAIN=akashic.local
AKASHIC_LDAP_ADMIN_PASSWORD=ldapadmin123
AKASHIC_LDAP_CONFIG_PASSWORD=ldapconfig123
AKASHIC_LDAP_HOST_PORT=389
AKASHIC_LDAP_LDAPS_HOST_PORT=636
AKASHIC_PHPLDAPADMIN_HOST_PORT=25002

# Akashic
AKASHIC_SECRET=password123
AKASHIC_TZ=Canada/Mountain

# Akashic server (Phase 4 — applies to both host-run and --profile app containerized run)
AKASHIC_AUTH_HOST_PORT=8080
AKASHIC_CTRL_HOST_PORT=8081
# In-process fsnotify watcher that reloads TLS certs on rotation.
# Set to false if you want to trigger rotation manually via POST /tls/reload
# or via process restart (e.g. to reduce background fd usage).
AKASHIC_PKI_CERT_WATCHER_ENABLED=true

# Vault
AKASHIC_VAULT_ADDRESS=https://localhost:8200
AKASHIC_VAULT_TLS_CACERT=./certs/vault/root-ca.crt
AKASHIC_VAULT_USERNAME=admin
AKASHIC_VAULT_PASSWORD=vault123
AKASHIC_VAULT_HOST_PORT=8200
AKASHIC_VAULT_CLUSTER_PORT=8201
AKASHIC_PKI_CRL_BASE_URL=http://localhost:8280 # [optional] Used for AIA, replace with the actual URL

# Phase 7: OAuth issuer + admin redirect URI.
# Both the akashic-server and the admin-bff read these so the JWT
# `iss` claim, the registered client_services redirect_uri, and the
# BFF's expected callback all stay in lockstep.
#
# These should match the URLs your browser actually reaches:
#   - issuer = base URL of the auth.* subdomain
#   - admin-redirect-uri = base URL of the admin.* subdomain + /oauth/callback
AKASHIC_OAUTH_ISSUER=https://auth.akashic.example.com
AKASHIC_OAUTH_ADMIN_REDIRECT_URI=https://admin.akashic.example.com/oauth/callback