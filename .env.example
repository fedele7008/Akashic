# ============================================================================
# Akashic IDP Configuration - Environment Variables
# ============================================================================
# This file contains environment variables for docker-compose and Akashic.
# Copy this file to .env and customize for your deployment.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values
#   docker-compose up -d
# ============================================================================

# ============================================================================
# Deployment Configuration
# ============================================================================

# Service Toggles - Enable/disable bundled services
# Set to "false" to use external services (BYOLDAP, BYOBFF, etc.)
AKASHIC_USE_BUNDLED_LDAP=true
AKASHIC_USE_BUNDLED_BFF=true
AKASHIC_USE_BUNDLED_WEB=true

# Observability - Enable Loki and Grafana (use --profile obs)
AKASHIC_ENABLE_OBSERVABILITY=false

# ============================================================================
# SSL/TLS Configuration
# ============================================================================

# Control Server TLS (Recommended: true for production)
AKASHIC_CONTROL_TLS_ENABLED=true

# Auth Server TLS (Recommended: true for production)
AKASHIC_AUTH_TLS_ENABLED=false

# LDAP TLS (Recommended: true for production)
AKASHIC_LDAP_TLS_ENABLED=false

# ============================================================================
# Akashic Server Configuration
# ============================================================================

# Auth Server Port (default: 8080)
AKASHIC_AUTH_SERVER_PORT=8080

# Control Server Port (default: 8081, localhost only)
AKASHIC_CONTROL_SERVER_PORT=8081

# Timezone
AKASHIC_TZ=UTC

# ============================================================================
# PostgreSQL Database Configuration
# ============================================================================

AKASHIC_DATABASE_POSTGRES_USERNAME=akashic
AKASHIC_DATABASE_POSTGRES_PASSWORD=changeme-postgres-password
AKASHIC_DATABASE_POSTGRES_DB=akashic
AKASHIC_DATABASE_POSTGRES_HOST_PORT=5432

# ============================================================================
# Redis Configuration
# ============================================================================

AKASHIC_DATABASE_REDIS_PASSWORD=changeme-redis-password
AKASHIC_DATABASE_REDIS_HOST_PORT=6379

# ============================================================================
# LDAP Configuration (Bundled LDAP - Profile: ldap)
# ============================================================================

# Organization and Domain
AKASHIC_LDAP_ORGANISATION=Akashic
AKASHIC_LDAP_DOMAIN=akashic.local

# Admin Credentials
AKASHIC_LDAP_ADMIN_PASSWORD=changeme-ldap-admin-password
AKASHIC_LDAP_CONFIG_PASSWORD=changeme-ldap-config-password

# Ports
AKASHIC_LDAP_HOST_PORT=389
AKASHIC_LDAP_LDAPS_HOST_PORT=636

# phpLDAPadmin Web Interface Port
AKASHIC_PHPLDAPADMIN_HOST_PORT=8090

# ============================================================================
# External LDAP Configuration (BYOLDAP)
# ============================================================================
# When AKASHIC_USE_BUNDLED_LDAP=false, configure external LDAP here
# Also update configs/config.yaml with LDAP connection details

# External LDAP Server
# AKASHIC_EXTERNAL_LDAP_HOST=ldap.company.com
# AKASHIC_EXTERNAL_LDAP_PORT=636
# AKASHIC_EXTERNAL_LDAP_BASE_DN=dc=company,dc=com
# AKASHIC_EXTERNAL_LDAP_ADMIN_DN=cn=admin,dc=company,dc=com
# AKASHIC_EXTERNAL_LDAP_ADMIN_PASSWORD=external-ldap-password

# ============================================================================
# External BFF Configuration (BYOBFF)
# ============================================================================
# When AKASHIC_USE_BUNDLED_BFF=false, configure external BFF here

# External BFF URL
# AKASHIC_EXTERNAL_BFF_URL=https://bff.company.com

# Control Server External Access (required for external BFF)
# AKASHIC_CONTROL_SERVER_EXTERNAL_ACCESS=true

# ============================================================================
# External Web Frontend Configuration (BYOWeb)
# ============================================================================
# When AKASHIC_USE_BUNDLED_WEB=false, configure external web frontend here

# External Web Frontend URL
# AKASHIC_EXTERNAL_WEB_URL=https://app.company.com

# CORS Configuration (for external web frontend)
# AKASHIC_CORS_ENABLED=true
# AKASHIC_CORS_ALLOWED_ORIGINS=https://app.company.com,https://admin.company.com

# ============================================================================
# Observability - Loki and Grafana (Profile: obs)
# ============================================================================

# Loki Configuration
AKASHIC_LOKI_HOST_PORT=3100
AKASHIC_LOKI_API_URL=http://loki:3100/loki/api/v1/push

# Grafana Configuration
AKASHIC_GF_SECURITY_ADMIN_USER=admin
AKASHIC_GF_SECURITY_ADMIN_PASSWORD=changeme-grafana-password
AKASHIC_GF_HOST_PORT=3000

# ============================================================================
# Adminer - Database Management Tool
# ============================================================================

AKASHIC_ADMINER_HOST_PORT=25000

# ============================================================================
# Development Settings
# ============================================================================

# Verbose Logging
# AKASHIC_VERBOSE=true

# Development Mode
# AKASHIC_DEVELOPMENT_MODE=true

# ============================================================================
# Security Notes
# ============================================================================
#
# IMPORTANT: Change all default passwords before production deployment!
#
# - AKASHIC_DATABASE_POSTGRES_PASSWORD
# - AKASHIC_DATABASE_REDIS_PASSWORD
# - AKASHIC_LDAP_ADMIN_PASSWORD
# - AKASHIC_LDAP_CONFIG_PASSWORD
# - AKASHIC_GF_SECURITY_ADMIN_PASSWORD
#
# Use strong passwords with:
# - Minimum 16 characters
# - Mix of uppercase, lowercase, numbers, and special characters
# - No dictionary words
#
# Generate secure passwords:
#   openssl rand -base64 32
#
# ============================================================================
# Deployment Scenarios
# ============================================================================
#
# 1. Default Full Stack (Development):
#    AKASHIC_USE_BUNDLED_LDAP=true
#    AKASHIC_USE_BUNDLED_BFF=true
#    AKASHIC_USE_BUNDLED_WEB=true
#    Command: docker-compose up -d
#
# 2. With Observability:
#    Command: docker-compose --profile obs up -d
#
# 3. With LDAP:
#    Command: docker-compose --profile ldap up -d
#
# 4. Full Stack with Everything:
#    Command: docker-compose --profile ldap --profile obs up -d
#
# 5. BYOLDAP (External LDAP):
#    AKASHIC_USE_BUNDLED_LDAP=false
#    AKASHIC_EXTERNAL_LDAP_HOST=ldap.company.com
#    # Update configs/config.yaml with LDAP details
#    Command: docker-compose up -d
#
# 6. Minimal API-Only:
#    AKASHIC_USE_BUNDLED_LDAP=false
#    AKASHIC_USE_BUNDLED_BFF=false
#    AKASHIC_USE_BUNDLED_WEB=false
#    AKASHIC_EXTERNAL_LDAP_HOST=ldap.company.com
#    Command: docker-compose up -d
#
# ============================================================================
# Quick Start
# ============================================================================
#
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Edit .env and change passwords:
#    vim .env
#
# 3. Start services (default configuration):
#    docker-compose up -d
#
# 4. Access Akashic:
#    Auth Server: http://localhost:8080
#    Control Server: https://localhost:8081 (mTLS required)
#
# 5. Create admin account (via CLI):
#    ./build/akashic cli admin create \
#      --username admin \
#      --password secure-password
#
# ============================================================================
