# ─── Service ports & admin-tool basic auth ──────────────────────────
AKASHIC_NGINX_PORT=8280
AKASHIC_ADMINER_AUTH_USER=admin
AKASHIC_ADMINER_AUTH_PASSWORD=adminer123
AKASHIC_REDISINSIGHT_AUTH_USER=admin
AKASHIC_REDISINSIGHT_AUTH_PASSWORD=redisinsight123
AKASHIC_PHPLDAPADMIN_AUTH_USER=admin
AKASHIC_PHPLDAPADMIN_AUTH_PASSWORD=phpldapadmin123

# ─── Postgres ───────────────────────────────────────────────────────
AKASHIC_POSTGRES_TLS=off                              # on|off
AKASHIC_DATABASE_POSTGRES_USERNAME=admin
AKASHIC_DATABASE_POSTGRES_PASSWORD=postgres123
AKASHIC_DATABASE_POSTGRES_DB=akashic
AKASHIC_DATABASE_POSTGRES_HOST_PORT=5432

# ─── Redis ──────────────────────────────────────────────────────────
AKASHIC_REDIS_TLS=on                                  # on|off
AKASHIC_DATABASE_REDIS_PASSWORD=redis123
AKASHIC_DATABASE_REDIS_HOST_PORT=6379

# ─── Loki + Grafana ─────────────────────────────────────────────────
AKASHIC_LOKI_PROXY_TLS=on                             # on|off
AKASHIC_LOKI_PROXY_HOST=localhost
AKASHIC_LOKI_PROXY_HOST_PORT=3100
AKASHIC_GF_SECURITY_ADMIN_USER=admin
AKASHIC_GF_SECURITY_ADMIN_PASSWORD=grafana123
AKASHIC_GF_HOST_PORT=3000

# ─── LDAP ───────────────────────────────────────────────────────────
AKASHIC_LDAP_TLS=on                                   # on|off (forces LDAPS port 636)
AKASHIC_LDAP_ORGANISATION=Akashic
AKASHIC_LDAP_DOMAIN=akashic.local
AKASHIC_LDAP_ADMIN_PASSWORD=ldapadmin123
AKASHIC_LDAP_CONFIG_PASSWORD=ldapconfig123
AKASHIC_LDAP_HOST_PORT=389
AKASHIC_LDAP_LDAPS_HOST_PORT=636
AKASHIC_PHPLDAPADMIN_HOST_PORT=25002

# ─── Akashic core ───────────────────────────────────────────────────
AKASHIC_SECRET=password123
AKASHIC_TZ=Canada/Mountain
AKASHIC_AUTH_HOST_PORT=8080                           # public OIDC/auth
AKASHIC_API_HOST_PORT=8082                            # public bearer-auth API
AKASHIC_CTRL_HOST_PORT=8081                           # loopback-only mTLS control plane
AKASHIC_PKI_CERT_WATCHER_ENABLED=true                 # false → manual via POST /tls/reload

# ─── Vault ──────────────────────────────────────────────────────────
AKASHIC_VAULT_ADDRESS=https://localhost:8200
AKASHIC_VAULT_TLS_CACERT=./certs/vault/root-ca.crt
AKASHIC_VAULT_USERNAME=admin
AKASHIC_VAULT_PASSWORD=vault123
AKASHIC_VAULT_HOST_PORT=8200
AKASHIC_VAULT_CLUSTER_PORT=8201
AKASHIC_PKI_CRL_BASE_URL=http://localhost:8280

# ─── Public URLs ────────────────────────────────────────────────────
# Must match what the browser reaches. Mismatches → redirect_uri_mismatch
# (auth callbacks) or ERR_NAME_NOT_RESOLVED (widget fetches).
AKASHIC_OAUTH_ISSUER=https://auth.akashic.example.com
AKASHIC_OAUTH_ADMIN_REDIRECT_URI=https://admin.akashic.example.com/oauth/callback
AKASHIC_PORTAL_API_BASE_URL=https://api.akashic.example.com

# Tenant product origins permitted to embed widgets and call api.<tenant>
# with credentials. Comma-separated. Required for any widget integration.
AKASHIC_PORTAL_TENANT_ORIGINS=

# ─── OAuth client registration ──────────────────────────────────────
# All tenant clients (your portal, sub-services, the in-stack samples)
# are registered post-bootstrap via:
#   akashic-cli clients create --type WEB|SPA ...   (CLI)
#   https://admin.<tenant>/                         (admin web console)
#
# Only one server-managed built-in remains: akashic-admin (used by
# admin-bff for OIDC login). Toggle off for "minimal mode" — CLI is
# the only operator surface, no admin web console.
AKASHIC_OAUTH_ADMIN_BFF_ENABLED=true

# ─── Next.js sample (services/portal/) ──────────────────────────────
# Sample reads its OAuth client_id + client_secret from a credentials
# JSON file written by the CLI (see `--save-credentials-to`):
#   .secrets/sample/nextjs.json   (mounted into the container)
# The redirect URI below stays as env because it depends on the
# deployment's public domain — must match what the operator passed
# to `akashic-cli clients create --redirect-uri ...`.
AKASHIC_OAUTH_SAMPLE_NEXTJS_REDIRECT_URI=https://akashic.example.com/api/auth/callback
