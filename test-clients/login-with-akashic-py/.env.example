# login-with-akashic-py — environment template.
#
# Copy this file to `.env` (same directory) and fill in the three
# REQUIRED values. The optional ones can stay commented out unless
# you need to override the defaults.
#
#   cp .env.example .env
#   # then edit .env with your real values
#   python app.py


# ─── Required ────────────────────────────────────────────────────────

# AKASHIC_ISSUER is the URL of the AKASHIC AUTH SERVER — NOT this
# Flask demo. The auth server's /.well-known/openid-configuration
# must be reachable at this base.
#   ✓  https://auth.akashic.example.com
#   ✗  http://localhost:5050   (that's THIS demo's URL — common mistake)
AKASHIC_ISSUER=https://auth.akashic.example.com

# OAuth client credentials issued by `akashic-cli clients create`.
# Run that command FIRST with --redirect-uri http://localhost:5050/callback
# (or whatever AKASHIC_TEST_REDIRECT_URI you set below), then paste the
# printed values here.
AKASHIC_TEST_CLIENT_ID=tc-xxxxxxxxxx
AKASHIC_TEST_CLIENT_SECRET=replace-with-the-secret-printed-by-clients-create


# ─── Optional ────────────────────────────────────────────────────────

# Local bind port. Default 5050 (avoids macOS AirPlay's port-5000
# squatter). If you change this, re-register the client with the
# matching --redirect-uri.
#AKASHIC_TEST_PORT=5050

# OAuth redirect_uri. Must match exactly what was registered in
# `akashic-cli clients create`. Default uses AKASHIC_TEST_PORT
# above; only override if you registered a different URL.
#AKASHIC_TEST_REDIRECT_URI=http://localhost:5050/callback

# OAuth scopes. Space-separated. `openid` is required for the
# id_token; `profile email` populates the optional id_token claims.
#AKASHIC_TEST_SCOPE=openid profile email

# TLS verification toggle for calls into Akashic. Set to `false` if
# your Akashic deployment uses a self-signed CA your Python doesn't
# trust AND you don't want to wire REQUESTS_CA_BUNDLE. Dev only.
#AKASHIC_TLS_VERIFY=true

# Path to a CA bundle that includes Akashic's signing CA. Standard
# Python pattern; preferred over disabling TLS verification.
#REQUESTS_CA_BUNDLE=/path/to/akashic-ca.pem
